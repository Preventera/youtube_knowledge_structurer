# Clé d'API Anthropic. Ne jamais committer ce fichier une fois rempli.
ANTHROPIC_API_KEY=votre_cle_ici

# Modèle Claude utilisé pour l'analyse.
# Vérifiez la liste courante : https://docs.claude.com/en/docs/about-claude/models/overview
YKS_MODEL=claude-sonnet-5

# Paramètres d'exécution (facultatifs)
YKS_TEMPERATURE=0
YKS_MAX_RETRIES=3
YKS_TIMEOUT_SECONDS=120
YKS_CHUNK_CHARACTERS=12000
YKS_LOG_LEVEL=INFO
